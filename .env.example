# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o arquivo ".env" - ele contem segredos.

# --- Modo mock (sem AD/SQL Server reais, usa dados de exemplo) ---
# Use AD_MOCK=true e DB_MOCK=true para rodar o painel localmente sem
# acesso a rede corporativa, so para validar a interface.
AD_MOCK=false
DB_MOCK=false

# --- Active Directory ---
AD_URL=ldap://Tv1.int
AD_BASE_DN=DC=Tv1,DC=int
AD_BIND_DN=tv1\adsync
AD_BIND_PASSWORD=

# --- SQL Server (banco GrupoTv1_Seguranca) ---
DB_SERVER=srvw-sqlpr01\WEB
DB_DATABASE=GrupoTv1_Seguranca
DB_USER=GrupoTv1_Seguranca
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Painel web ---
PORT=3000
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
ADMIN_USER=admin
# Gere o hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
ADMIN_PASSWORD_HASH=

# --- Agendamento da sincronizacao completa (cron) ---
# Padrao: todos os dias as 23h (equivalente ao comportamento do servico C#)
SYNC_CRON=0 23 * * *
SYNC_ENABLED=true
